---
import Layout from '../../layouts/Layout.astro';
import HeroServicesJourney from '../../components/HeroServicesJourney.astro';
import SupportTeaser from '../../components/SupportTeaser.astro';
import TrustedBy from '../../components/TrustedBy.astro';

const title = 'ElPuas Digital Crafts | Sviluppo Web con Amore e Precisione';
const description = 'Realizziamo siti veloci, accessibili e scalabili con WordPress, Astro e flussi di lavoro potenziati dall’IA. Partner fidati di agenzie e aziende in tutto il mondo.';
const lang = 'it';
---

<Layout {title} {description} {lang}>
  <HeroServicesJourney {lang}>
    <SupportTeaser
      title="Il lancio è solo l’inizio."
      description="Il tuo sito ha bisogno di cura e spazio per evolversi. Ti affianchiamo con manutenzione, supporto e miglioramenti, perché continui a rispondere alle esigenze della tua attività."
      ctaLabel="Scopri i nostri servizi di supporto"
      ctaHref="/it/services/#pricing-title"
    />
    <TrustedBy title="Brand con cui abbiamo collaborato." />
  </HeroServicesJourney>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style> 
