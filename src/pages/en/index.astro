---
import Layout from '../../layouts/Layout.astro';
import HeroServicesJourney from '../../components/HeroServicesJourney.astro';
import SupportTeaser from '../../components/SupportTeaser.astro';
import TrustedBy from '../../components/TrustedBy.astro';

const title = 'ElPuas Digital Crafts | Web Development with Love and Precision';
const description = 'We build fast, affordable, and beautifully crafted websites for businesses and agencies — powered by WordPress, Astro, and AI-enhanced workflows. Based in Costa Rica, with clients worldwide.';
const lang = 'en';
---

<Layout {title} {description} {lang}>
  <HeroServicesJourney {lang}>
    <SupportTeaser
      title="Launch is only the beginning."
      description="Your site needs care and room to evolve. We’re here with maintenance, support, and improvements so it keeps up with the needs of your business."
      ctaLabel="Explore our support services"
      ctaHref="/en/services/#pricing-title"
    />
    <TrustedBy title="Brands we’ve built with." />
  </HeroServicesJourney>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
