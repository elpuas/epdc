---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Defender from '../components/games/Defender/Defender.astro';
import styles from '../styles/404.module.css';

const title = '404 — Page Not Found | ElPuas Digital Crafts';
const description = 'The page you are looking for could not be found. Return to our homepage to explore our web development services.';
const lang = 'en';
---

<Layout {title} {description} {lang}>
  <section class={styles.errorPage} aria-labelledby="error-title">
    <div class={styles.errorContent}>
      <p class={styles.kicker}>Signal lost</p>
      <h1 id="error-title">404 — Page Not Found</h1>
      <p class={styles.errorMessage}>
        The route drifted out of range. Clear a path through the noise, or jump back to familiar coordinates.
      </p>
      <Defender width={960} height={420} autoplay showHUD showControls />
      <div class={styles.actions}>
        <Button href="/en/" label="Return Home" />
        <Button href="/en/contact" label="Contact Us" variant="outline" />
      </div>
    </div>
  </section>
</Layout> 
