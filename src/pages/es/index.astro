---
import Layout from '../../layouts/Layout.astro';
import HeroServicesJourney from '../../components/HeroServicesJourney.astro';
import SupportTeaser from '../../components/SupportTeaser.astro';
import TrustedBy from '../../components/TrustedBy.astro';

const title = 'ElPuas Digital Crafts | Desarrollo Web con Amor y Precisión';
const description = 'Creamos sitios web rápidos, accesibles y escalables usando WordPress, Astro y flujos de trabajo potenciados por IA. Confiados por agencias y negocios en todo el mundo.';
const lang = 'es';
---

<Layout {title} {description} {lang}>
  <HeroServicesJourney {lang}>
    <SupportTeaser
      title="El lanzamiento es solo el comienzo."
      description="Tu sitio necesita cuidado y espacio para evolucionar. Te acompañamos con mantenimiento, soporte y mejoras para que siga respondiendo a las necesidades de tu negocio."
      ctaLabel="Conoce nuestros servicios de soporte"
      ctaHref="/es/services/#pricing-title"
    />
    <TrustedBy title="Marcas con las que hemos trabajado." />
  </HeroServicesJourney>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0; 
  }
</style> 
