---
import { Image } from 'astro:assets';
import ServiceFormationFallback from './ServiceFormationFallback.astro';

import avalancheLogo from '../../public/brands/avalanche.png';
import pbLogo from '../../public/brands/pb.png';
import monkeyLogo from '../../public/brands/monkey.png';
import fishcostaricaLogo from '../../public/brands/fishcostarica.png';
import voyagerLogo from '../../public/brands/Logo-rojo-voyager.png';

const { title = 'Brands we’ve built with.' } = Astro.props;

const logos = [
    {
        src: avalancheLogo,
        alt: 'Avalanche Advertising',
        name: 'avalanche'
    },
    {
        src: pbLogo,
        alt: 'Premium Brokers',
        name: 'premium'
    },
    {
        src: monkeyLogo,
        alt: 'Monkey Scrubs',
        name: 'monkey'
    },
    {
        src: fishcostaricaLogo,
        alt: 'Costa Rica Fishing',
        name: 'fishing'
    },
    {
        src: voyagerLogo,
        alt: 'Voyager Comunicación',
        name: 'voyager'
    },
];
---

<section class="trusted-by" aria-labelledby="trusted-by-title" data-neural-formation="clients" data-neural-clients>
    <div class="trusted-by__network" data-neural-visual aria-hidden="true">
        <ServiceFormationFallback system="clients" />
    </div>

    <h2 id="trusted-by-title" class="trusted-by__title text-gradient-brand" data-neural-title>{title}</h2>

    <div class="trusted-by__ticker" data-neural-copy tabindex="0" role="group" aria-labelledby="trusted-by-title">
        <div class="trusted-by__track">
            <ul class="trusted-by__group">
                {logos.map(({ src, alt, name }) => (
                    <li class={`trusted-by__logo trusted-by__logo--${name}`}>
                        <Image src={src} alt={alt} width={320} height={160} loading="lazy" decoding="async" />
                    </li>
                ))}
            </ul>
            <ul class="trusted-by__group" aria-hidden="true">
                {logos.map(({ src, name }) => (
                    <li class={`trusted-by__logo trusted-by__logo--${name}`}>
                        <Image src={src} alt="" width={320} height={160} loading="lazy" decoding="async" />
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>

<style>
    .trusted-by {
        position: relative;
        isolation: isolate;
        padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(5rem, 10vw, 8rem);
    }

    .trusted-by__network {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: .06;
        mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 45%, transparent 92%);
    }

    .trusted-by__title {
        margin: 0 0 clamp(1.75rem, 3vw, 2.75rem);
        padding-inline: clamp(.5rem, 2vw, 2rem);
        font-size: clamp(2.2rem, 3.8vw, 3.8rem);
        line-height: 1.08;
        letter-spacing: -.055em;
        text-align: left;
    }

    .trusted-by__ticker {
        overflow: hidden;
        max-width: 100%;
        mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    }

    .trusted-by__ticker:focus-visible {
        outline: 2px solid var(--color-tertiary);
        outline-offset: 4px;
    }

    .trusted-by__track {
        display: flex;
        width: max-content;
        animation: trusted-by-scroll 48s linear infinite;
        will-change: transform;
    }

    .trusted-by__group {
        box-sizing: border-box;
        display: flex;
        flex: none;
        align-items: center;
        justify-content: space-around;
        gap: clamp(2.5rem, 5vw, 5rem);
        width: max(100vw, 90rem);
        height: clamp(5.5rem, 9vw, 7.25rem);
        margin: 0;
        padding: 0 clamp(1.25rem, 2.5vw, 2.5rem);
        list-style: none;
    }

    .trusted-by__logo {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: clamp(8rem, 13vw, 12rem);
        height: 100%;
    }

    .trusted-by__logo :global(img) {
        display: block;
        width: 100%;
        height: auto;
        max-height: 100%;
        object-fit: contain;
        filter: grayscale(1) brightness(var(--logo-brightness, 1));
        opacity: .75;
    }

    .trusted-by__logo--avalanche { --logo-brightness: 3.5; }
    .trusted-by__logo--premium { --logo-brightness: 2.4; width: clamp(9rem, 14vw, 12.5rem); }
    .trusted-by__logo--monkey { width: clamp(5.5rem, 7.5vw, 7rem); }
    .trusted-by__logo--fishing { width: clamp(9rem, 14vw, 12.5rem); }
    .trusted-by__logo--voyager { --logo-brightness: 2.3; width: clamp(8rem, 12vw, 11rem); }

    .trusted-by__ticker:hover .trusted-by__track,
    .trusted-by__ticker:focus-within .trusted-by__track,
    .trusted-by__ticker:active .trusted-by__track { animation-play-state: paused; }

    :global([data-neural-enhanced='true']) [data-neural-title],
    :global([data-neural-enhanced='true']) [data-neural-copy] {
        opacity: var(--reveal-opacity, 1);
        transform: translateY(var(--reveal-rise, 0px));
    }

    .trusted-by:focus-within [data-neural-title],
    .trusted-by:focus-within [data-neural-copy] { opacity: 1 !important; transform: none !important; }

    :global(:root[data-theme='bw']) .trusted-by__logo :global(img) { filter: grayscale(1) brightness(var(--logo-brightness, 1)) invert(1); }

    @keyframes trusted-by-scroll {
        to { transform: translate3d(-50%, 0, 0); }
    }

    @media (max-width: 767px) {
        .trusted-by { padding-block: 3.5rem 5rem; }
        .trusted-by__group { width: max(100vw, 58rem); gap: 2.5rem; padding-inline: 1.25rem; }
        .trusted-by__logo { width: 8rem; }
        .trusted-by__logo--premium, .trusted-by__logo--fishing { width: 9rem; }
        .trusted-by__logo--monkey { width: 5.5rem; }
        .trusted-by__logo--voyager { width: 8rem; }
        .trusted-by__ticker { mask-image: linear-gradient(to right, transparent, #000 11%, #000 89%, transparent); }
    }

    @media (prefers-reduced-motion: reduce) {
        .trusted-by__track { display: block; width: 100%; animation: none; will-change: auto; }
        .trusted-by__group {
            flex-wrap: wrap;
            justify-content: center;
            width: 100%;
            height: auto;
            gap: 1rem;
            padding-inline: 0;
        }
        .trusted-by__logo,
        .trusted-by__logo--premium,
        .trusted-by__logo--monkey,
        .trusted-by__logo--fishing,
        .trusted-by__logo--voyager { flex: 1 1 0; width: auto; min-width: 0; height: 5rem; }
        .trusted-by__logo :global(img) { max-width: 12rem; }
        .trusted-by__logo--monkey :global(img) { max-width: 7rem; }
        .trusted-by__group[aria-hidden='true'] { display: none; }
        .trusted-by__ticker { mask-image: none; }
        [data-neural-title], [data-neural-copy] { opacity: 1 !important; transform: none !important; }
    }

    @media (prefers-reduced-motion: reduce) and (max-width: 767px) {
        .trusted-by__group { row-gap: .5rem; }
        .trusted-by__logo,
        .trusted-by__logo--premium,
        .trusted-by__logo--monkey,
        .trusted-by__logo--fishing,
        .trusted-by__logo--voyager { flex: 0 0 calc(50% - .5rem); height: 4.5rem; }
        .trusted-by__logo--monkey :global(img) { max-width: 5.5rem; }
    }
</style>
