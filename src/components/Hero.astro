---
import Button from './Button.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const heroContent = {
  en: {
    eyebrow: 'Applied AI. Development with judgment.',
    headline: 'Do more with less, without losing control.',
    body: 'We combine AI, automation, and custom digital development to turn repetitive work into meaningful progress, with strategic judgment and technical quality.',
    cta: 'Let’s talk about what we can improve',
    href: '/en/services/',
  },
  es: {
    eyebrow: 'IA aplicada. Desarrollo con criterio.',
    headline: 'Haz más con menos, sin perder el control.',
    body: 'Combinamos IA, automatización y desarrollo digital a medida para transformar trabajo repetitivo en avances reales, con criterio estratégico y calidad técnica.',
    cta: 'Conversemos sobre lo que podemos mejorar',
    href: '/es/services/',
  },
  it: {
    eyebrow: 'IA applicata. Sviluppo con criterio.',
    headline: 'Fai di più con meno, senza perdere il controllo.',
    body: 'Combiniamo IA, automazione e sviluppo digitale su misura per trasformare il lavoro ripetitivo in progressi concreti, con visione strategica e qualità tecnica.',
    cta: 'Parliamo di ciò che possiamo migliorare',
    href: '/it/services/',
  },
};

const content = heroContent[lang as keyof typeof heroContent] || heroContent.en;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-content">
    <p class="hero-eyebrow">{content.eyebrow}</p>
    <h1 id="hero-heading" class="text-gradient-brand">{content.headline}</h1>
    <p class="hero-body">{content.body}</p>
    <div class="hero-cta">
      <Button href={content.href} label={content.cta} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    min-height: clamp(30rem, 58vh, 40rem);
    overflow: hidden;
    padding: clamp(var(--space-2xl), 5vw, 5rem);
    display: grid;
    align-items: center;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 76%) 0%, rgb(0 0 0 / 58%) 45%, rgb(0 0 0 / 22%) 67%, rgb(0 0 0 / 2%) 100%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 56rem;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-lg);
    color: var(--color-tertiary);
    font-family: var(--font-family-heading);
    font-size: clamp(0.875rem, 0.78rem + 0.5vw, 1.125rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h1 {
    max-width: 22ch;
    margin-bottom: var(--space-lg);
    letter-spacing: -0.05em;
  }

  .hero-body {
    max-width: 47ch;
    margin: 0;
    color: var(--color-white);
    font-size: clamp(1.125rem, 1rem + 0.55vw, 1.45rem);
    font-weight: 400;
  }

  .hero-cta {
    margin-top: var(--space-xl);
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 0;
      padding: var(--space-2xl) var(--space-md);
    }

    .hero::after {
      background: linear-gradient(90deg, rgb(0 0 0 / 94%), rgb(0 0 0 / 82%));
    }

    h1 {
      font-size: clamp(3rem, 12vw, 4rem);
    }
  }
</style>
