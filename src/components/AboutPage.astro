---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HomeProjectShowcaseVisual from './HomeProjectShowcaseVisual.astro';
import NeuralJourneyBackground from './NeuralJourneyBackground.astro';
import AboutFormation from './AboutFormation.astro';
import catalina from '../../public/team/catalina-valverde-dos.webp';
import alfredo from '../../public/team/foto-uno.webp';
import gianfranco from '../../public/team/gianfranco.webp';
import styles from '../styles/AboutJourney.module.css';

interface Props { lang: 'es' | 'en' | 'it' }
const { lang } = Astro.props;
const translations = {
  es: {
    title: 'Conocé ElPuas Digital Crafts | Un Estudio Web Familiar', description: 'Conocé al equipo de ElPuas Digital Crafts y nuestra forma de crear experiencias digitales.',
    intro: 'Quiénes somos', headline: 'Desarrollo digital con criterio humano.', lead: 'Somos ElPuas Digital Crafts, un estudio familiar de Costa Rica. Creamos sitios y experiencias digitales combinando desarrollo, automatización e inteligencia artificial aplicada, con personas al mando.', introLink: 'Hablemos de lo que querés mejorar',
    approach: 'Nuestra historia', approachTitle: 'Un estudio familiar, con el corazón en lo que hacemos.', approachText: [
      'Somos ElPuas Digital Crafts, un estudio web familiar que construye sitios web de alto rendimiento con amor, código y café.',
