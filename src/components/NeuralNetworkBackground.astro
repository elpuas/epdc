<div class="network-background" aria-hidden="true" data-network-background>
  <canvas class="network-background__canvas"></canvas>
</div>

<script>
  type NetworkRoot = HTMLElement & { dataset: DOMStringMap };

  const canUseAnimatedNetwork = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hasFinePointer = window.matchMedia('(min-width: 768px) and (pointer: fine)');

    return !prefersReducedMotion.matches && hasFinePointer.matches;
  };

  const hasWebGL = (canvas: HTMLCanvasElement) => {
    try {
      return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'));
    } catch {
      return false;
    }
  };

  const mountNetwork = async (root: NetworkRoot) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas');
    if (!canvas || !canUseAnimatedNetwork() || !hasWebGL(canvas)) return;

    root.dataset.networkMounted = 'true';

    try {
      const THREE = await import('three');

      // Recheck after the asynchronous import in case the viewport or motion
      // preference changed while the module was loading.
      if (!canUseAnimatedNetwork()) return;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 100);
      camera.position.z = 7;

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'low-power',
      });
      renderer.setClearColor(0x000000, 0);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

      const foregroundLayer = new THREE.Group();
      scene.add(foregroundLayer);

      const clusters = [
        {
          // A quieter upper branch that gives the field a second point of focus.
          center: [3.28, 1.18, 0.1],
          layout: [[0, 0], [0.28, 0.2], [0.7, 0.43], [1.1, 0.74], [-0.22, 0.31], [-0.5, 0.66], [0.18, -0.34], [0.56, -0.72], [1.02, -0.84]],
        },
        {
          // The principal cluster grows through the right and lower-right space.
          center: [3.28, -1.08, -0.1],
          layout: [[0, 0], [0.28, 0.22], [0.66, 0.5], [1.06, 0.78], [1.46, 0.9], [-0.24, 0.26], [-0.58, 0.6], [-0.98, 0.78], [0.34, -0.3], [0.74, -0.64], [1.16, -0.96], [-0.3, -0.38], [-0.58, -0.74]],
        },
        {
          center: [2.82, -2.08, 0.22],
          layout: [[0, 0], [0.3, 0.24], [0.75, 0.43], [1.16, 0.68], [-0.3, 0.2], [-0.7, 0.48], [0.24, -0.36], [0.56, -0.72]],
        },
        {
          center: [4.25, 0.05, -0.36],
          layout: [[0, 0], [0.28, 0.27], [0.68, 0.48], [-0.26, 0.3], [-0.54, 0.66], [0.12, -0.36]],
        },
      ] as const;

      const anchorIndexes = [0, 9, 22, 30] as const;
      const nodes = clusters.flatMap((cluster) => cluster.layout.map(([offsetX, offsetY]) => ({
        position: new THREE.Vector3(
          cluster.center[0] + offsetX,
          cluster.center[1] + offsetY,
          cluster.center[2] + (Math.random() - 0.5) * 0.5,
        ),
        drift: new THREE.Vector3(
          0.045 + Math.random() * 0.035,
          0.04 + Math.random() * 0.04,
          0.025 + Math.random() * 0.025,
        ),
        phase: Math.random() * Math.PI * 2,
      })));
      const nodeCount = nodes.length;
      const worldPositions = nodes.map(() => new THREE.Vector3());

      const pointsGeometry = new THREE.BufferGeometry();
      const pointPositions = new Float32Array(nodeCount * 3);
      pointsGeometry.setAttribute('position', new THREE.BufferAttribute(pointPositions, 3));
      const points = new THREE.Points(
        pointsGeometry,
        new THREE.PointsMaterial({
          color: 0x00fff3,
          size: 0.072,
          transparent: true,
          opacity: 0.84,
          sizeAttenuation: true,
        }),
      );
      foregroundLayer.add(points);

      // These are deliberately parent-child branches, not a uniform mesh.
      // Only the final three edges bridge clusters across the wider field.
      const edges: Array<[number, number, 'cyan' | 'lime' | 'bridge']> = [
        [0, 1, 'cyan'], [1, 2, 'cyan'], [2, 3, 'lime'], [0, 4, 'cyan'], [4, 5, 'cyan'], [0, 6, 'lime'], [6, 7, 'cyan'], [7, 8, 'cyan'],
        [9, 10, 'cyan'], [10, 11, 'cyan'], [11, 12, 'lime'], [12, 13, 'cyan'], [9, 14, 'cyan'], [14, 15, 'cyan'], [15, 16, 'lime'], [9, 17, 'lime'], [17, 18, 'cyan'], [18, 19, 'cyan'], [9, 20, 'cyan'], [20, 21, 'cyan'],
        [22, 23, 'cyan'], [23, 24, 'lime'], [24, 25, 'cyan'], [22, 26, 'cyan'], [26, 27, 'cyan'], [22, 28, 'lime'], [28, 29, 'cyan'],
        [30, 31, 'cyan'], [31, 32, 'lime'], [30, 33, 'cyan'], [33, 34, 'cyan'], [30, 35, 'lime'],
        [0, 30, 'bridge'], [30, 9, 'bridge'], [9, 22, 'bridge'],
      ];
      const lineGeometry = new THREE.BufferGeometry();
      const linePositions = new Float32Array(edges.length * 2 * 3);
      const lineColors = new Float32Array(edges.length * 2 * 3);
      lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
      lineGeometry.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));
      const lines = new THREE.LineSegments(
        lineGeometry,
        new THREE.LineBasicMaterial({
          vertexColors: true,
          transparent: true,
          opacity: 0.54,
        }),
      );
      foregroundLayer.add(lines);

      const anchorGeometry = new THREE.BufferGeometry();
      const anchorPositions = new Float32Array(anchorIndexes.length * 3);
      const anchorColors = new Float32Array(anchorIndexes.length * 3);
      anchorIndexes.forEach((_, index) => {
        anchorColors.set(index % 2 === 0 ? [0, 1, 0.95] : [0.85, 1, 0], index * 3);
      });
      anchorGeometry.setAttribute('position', new THREE.BufferAttribute(anchorPositions, 3));
      anchorGeometry.setAttribute('color', new THREE.BufferAttribute(anchorColors, 3));
      const anchorPoints = new THREE.Points(
        anchorGeometry,
        new THREE.PointsMaterial({
          vertexColors: true,
          size: 0.16,
          transparent: true,
          opacity: 0.98,
          sizeAttenuation: true,
        }),
      );
      foregroundLayer.add(anchorPoints);

      const glowCanvas = document.createElement('canvas');
      glowCanvas.width = 64;
      glowCanvas.height = 64;
      const glowContext = glowCanvas.getContext('2d');
      if (glowContext) {
        const gradient = glowContext.createRadialGradient(32, 32, 1, 32, 32, 32);
        gradient.addColorStop(0, 'rgba(255, 255, 255, 0.9)');
        gradient.addColorStop(0.18, 'rgba(0, 255, 243, 0.45)');
        gradient.addColorStop(1, 'rgba(0, 255, 243, 0)');
        glowContext.fillStyle = gradient;
        glowContext.fillRect(0, 0, 64, 64);
      }
      const glowTexture = new THREE.CanvasTexture(glowCanvas);
      const anchorGlows = anchorIndexes.map((nodeIndex, index) => {
        const glow = new THREE.Sprite(new THREE.SpriteMaterial({
          map: glowTexture,
          color: index % 2 === 0 ? 0x00fff3 : 0xd8ff00,
          transparent: true,
          opacity: 0.34,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
        }));
        glow.scale.set(0.38 + index * 0.035, 0.38 + index * 0.035, 1);
        foregroundLayer.add(glow);
        return { nodeIndex, glow, phase: index * 1.35 };
      });

      const signalRoutes = [
        { source: 9, target: 10, color: [0, 1, 0.95], speed: 0.19, phase: 0.04 },
        { source: 11, target: 12, color: [0.85, 1, 0], speed: 0.13, phase: 0.49 },
        { source: 22, target: 23, color: [0, 1, 0.95], speed: 0.23, phase: 0.21 },
        { source: 30, target: 31, color: [0.85, 1, 0], speed: 0.16, phase: 0.78 },
        { source: 17, target: 18, color: [0, 1, 0.95], speed: 0.11, phase: 0.66 },
      ] as const;
      const signalGeometry = new THREE.BufferGeometry();
      const signalPositions = new Float32Array(signalRoutes.length * 3);
      const signalColors = new Float32Array(signalRoutes.length * 3);
      signalRoutes.forEach(({ color }, index) => signalColors.set(color, index * 3));
      signalGeometry.setAttribute('position', new THREE.BufferAttribute(signalPositions, 3));
      signalGeometry.setAttribute('color', new THREE.BufferAttribute(signalColors, 3));
      const signals = new THREE.Points(
        signalGeometry,
        new THREE.PointsMaterial({
          vertexColors: true,
          size: 0.14,
          transparent: true,
          opacity: 0.96,
          sizeAttenuation: true,
          blending: THREE.AdditiveBlending,
        }),
      );
      foregroundLayer.add(signals);

      type AmbientEdge = readonly [number, number, 'cyan' | 'lime'];
      type AmbientSignal = Readonly<{
        source: number;
        target: number;
        color: readonly [number, number, number];
        speed: number;
        phase: number;
      }>;

      const createAmbientLayer = (config: {
        nodes: ReadonlyArray<readonly [number, number, number]>;
        edges: ReadonlyArray<AmbientEdge>;
        signals?: ReadonlyArray<AmbientSignal>;
        pointSize: number;
        pointOpacity: number;
        lineOpacity: number;
        signalSize?: number;
        scale: number;
        intensity: number;
        speed: number;
        drift: readonly [number, number, number];
      }) => {
        const layer = new THREE.Group();
        layer.scale.setScalar(config.scale);
        scene.add(layer);

        const layerNodes = config.nodes.map(([x, y, z]) => ({
          position: new THREE.Vector3(x, y, z),
          phase: Math.random() * Math.PI * 2,
          drift: new THREE.Vector3(
            config.speed * (0.75 + Math.random() * 0.35),
            config.speed * (0.7 + Math.random() * 0.4),
            config.speed * (0.65 + Math.random() * 0.3),
          ),
        }));
        const positions = new Float32Array(layerNodes.length * 3);
        const worldPositions = layerNodes.map(() => new THREE.Vector3());
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const nodePoints = new THREE.Points(
          geometry,
          new THREE.PointsMaterial({
            color: new THREE.Color(0, config.intensity, config.intensity * 0.95),
            size: config.pointSize,
            transparent: true,
            opacity: config.pointOpacity,
            sizeAttenuation: true,
          }),
        );
        layer.add(nodePoints);

        const lineGeometry = new THREE.BufferGeometry();
        const linePositions = new Float32Array(config.edges.length * 6);
        const lineColors = new Float32Array(config.edges.length * 6);
        lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
        lineGeometry.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));
        const layerLines = new THREE.LineSegments(
          lineGeometry,
          new THREE.LineBasicMaterial({
            vertexColors: true,
            transparent: true,
            opacity: config.lineOpacity,
          }),
        );
        layer.add(layerLines);

        const layerSignals = config.signals ?? [];
        const signalGeometry = new THREE.BufferGeometry();
        const signalPositions = new Float32Array(layerSignals.length * 3);
        const signalColors = new Float32Array(layerSignals.length * 3);
        layerSignals.forEach(({ color }, index) => signalColors.set(color, index * 3));
        signalGeometry.setAttribute('position', new THREE.BufferAttribute(signalPositions, 3));
        signalGeometry.setAttribute('color', new THREE.BufferAttribute(signalColors, 3));
        const signalPoints = new THREE.Points(
          signalGeometry,
          new THREE.PointsMaterial({
            vertexColors: true,
            size: config.signalSize ?? 0.06,
            transparent: true,
            opacity: config.pointOpacity * 1.15,
            sizeAttenuation: true,
            blending: THREE.AdditiveBlending,
          }),
        );
        if (layerSignals.length) layer.add(signalPoints);

        const update = (time: number) => {
          layerNodes.forEach((node, index) => {
            const position = worldPositions[index];
            position.set(
              node.position.x + Math.sin(time * node.drift.x + node.phase) * config.drift[0],
              node.position.y + Math.cos(time * node.drift.y + node.phase) * config.drift[1],
              node.position.z + Math.sin(time * node.drift.z + node.phase) * config.drift[2],
            );
            positions.set([position.x, position.y, position.z], index * 3);
          });

          config.edges.forEach(([source, target, colorName], index) => {
            const sourcePosition = worldPositions[source];
            const targetPosition = worldPositions[target];
            const color = colorName === 'lime'
              ? [0.85 * config.intensity, config.intensity, 0]
              : [0, config.intensity, config.intensity * 0.95];
            linePositions.set([
              sourcePosition.x, sourcePosition.y, sourcePosition.z,
              targetPosition.x, targetPosition.y, targetPosition.z,
            ], index * 6);
            lineColors.set([...color, ...color], index * 6);
          });

          layerSignals.forEach(({ source, target, speed, phase }, index) => {
            const progress = (time * speed + phase) % 1;
            const position = worldPositions[source].clone().lerp(worldPositions[target], progress);
            signalPositions.set([position.x, position.y, position.z], index * 3);
          });

          geometry.attributes.position.needsUpdate = true;
          lineGeometry.attributes.position.needsUpdate = true;
          lineGeometry.attributes.color.needsUpdate = true;
          if (layerSignals.length) signalGeometry.attributes.position.needsUpdate = true;
        };

        return { layer, update };
      };

      // The midground establishes the larger spatial structure before the viewer
      // notices the foreground's shorter, active dendrites.
      const midground = createAmbientLayer({
        nodes: [
          [-3.6, 2.65, -1.25], [-2.78, 2.25, -1.35], [-1.88, 2.52, -1.22], [-1.04, 2.16, -1.32], [-0.2, 2.44, -1.26], [-2.42, 1.52, -1.38], [-1.54, 1.23, -1.28], [-0.68, 1.52, -1.34],
          [0.72, 2.28, -1.3], [1.48, 2.72, -1.22], [2.28, 2.34, -1.36], [3.08, 2.67, -1.25], [3.88, 2.26, -1.33], [4.3, 1.62, -1.24],
          [0.18, 0.76, -1.35], [0.96, 1.12, -1.24], [1.72, 0.7, -1.34], [2.46, 1.02, -1.25], [3.14, 0.55, -1.37], [3.86, 0.84, -1.28],
          [1.92, -0.58, -1.32], [2.58, -0.12, -1.24], [3.28, -0.48, -1.36], [3.92, -0.08, -1.27], [4.42, -0.6, -1.35],
        ],
        edges: [
          [0, 1, 'cyan'], [1, 2, 'cyan'], [2, 3, 'lime'], [3, 4, 'cyan'], [1, 5, 'cyan'], [5, 6, 'cyan'], [6, 7, 'lime'],
          [8, 9, 'cyan'], [9, 10, 'lime'], [10, 11, 'cyan'], [11, 12, 'cyan'], [12, 13, 'lime'],
          [14, 15, 'cyan'], [15, 16, 'lime'], [16, 17, 'cyan'], [17, 18, 'cyan'], [18, 19, 'lime'],
          [20, 21, 'cyan'], [21, 22, 'lime'], [22, 23, 'cyan'], [23, 24, 'cyan'],
        ],
        signals: [
          { source: 9, target: 10, color: [0.85, 1, 0], speed: 0.07, phase: 0.18 },
          { source: 16, target: 17, color: [0, 1, 0.95], speed: 0.055, phase: 0.64 },
        ],
        pointSize: 0.075,
        pointOpacity: 0.75,
        lineOpacity: 0.58,
        signalSize: 0.1,
        scale: 1,
        intensity: 0.75,
        speed: 0.035,
        drift: [0.075, 0.052, 0.04],
      });

      // The distant layer crosses the whole hero as an intentionally sparse field.
      const background = createAmbientLayer({
        nodes: [
          [-4.55, 2.8, -2.45], [-3.62, 2.38, -2.34], [-2.72, 2.72, -2.48], [-1.72, 2.35, -2.38], [-0.7, 2.66, -2.46],
          [-4.3, 1.12, -2.4], [-3.34, 0.7, -2.5], [-2.32, 1.06, -2.36], [-1.22, 0.58, -2.47], [-0.1, 0.94, -2.39],
          [-3.65, -1.28, -2.43], [-2.6, -1.72, -2.35], [-1.5, -1.34, -2.48], [-0.38, -1.74, -2.37], [0.78, -1.32, -2.45],
          [1.76, 1.62, -2.4], [2.72, 1.25, -2.49], [3.78, 1.6, -2.36], [4.58, 1.08, -2.46],
        ],
        edges: [
          [0, 1, 'cyan'], [1, 2, 'cyan'], [2, 3, 'lime'], [3, 4, 'cyan'],
          [5, 6, 'cyan'], [6, 7, 'cyan'], [7, 8, 'lime'], [8, 9, 'cyan'],
          [10, 11, 'cyan'], [11, 12, 'lime'], [12, 13, 'cyan'], [13, 14, 'cyan'],
          [15, 16, 'cyan'], [16, 17, 'lime'], [17, 18, 'cyan'],
        ],
        pointSize: 0.055,
        pointOpacity: 0.45,
        lineOpacity: 0.32,
        scale: 1.2,
        intensity: 0.58,
        speed: 0.016,
        drift: [0.032, 0.024, 0.018],
      });

      const pointerTarget = new THREE.Vector2();
      const pointerCurrent = new THREE.Vector2();
      let isVisible = true;
      let animationFrame = 0;

      const updateSize = () => {
        const { width, height } = root.getBoundingClientRect();
        if (!width || !height) return;

        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      const updatePointer = (event: PointerEvent) => {
        const bounds = root.getBoundingClientRect();
        if (
          event.clientX < bounds.left || event.clientX > bounds.right ||
          event.clientY < bounds.top || event.clientY > bounds.bottom
        ) {
          pointerTarget.set(0, 0);
          return;
        }

        pointerTarget.set(
          ((event.clientX - bounds.left) / bounds.width - 0.5) * 0.18,
          -((event.clientY - bounds.top) / bounds.height - 0.5) * 0.12,
        );
      };

      const updateGeometry = (time: number) => {
        nodes.forEach((node, index) => {
          const offset = index * 3;
          const position = worldPositions[index];
          position.set(
            node.position.x + Math.sin(time * node.drift.x + node.phase) * 0.14,
            node.position.y + Math.cos(time * node.drift.y + node.phase) * 0.1,
            node.position.z + Math.sin(time * node.drift.z + node.phase) * 0.07,
          );
          pointPositions[offset] = position.x;
          pointPositions[offset + 1] = position.y;
          pointPositions[offset + 2] = position.z;
        });

        edges.forEach(([source, target, colorName], edgeIndex) => {
          const sourcePosition = worldPositions[source];
          const targetPosition = worldPositions[target];
          const lineOffset = edgeIndex * 6;
          const color = colorName === 'lime'
            ? [0.85, 1, 0]
            : colorName === 'bridge'
              ? [0.04, 0.31, 0.3]
              : [0, 1, 0.95];

          linePositions.set([
            sourcePosition.x, sourcePosition.y, sourcePosition.z,
            targetPosition.x, targetPosition.y, targetPosition.z,
          ], lineOffset);
          lineColors.set([...color, ...color], lineOffset);
        });

        anchorGlows.forEach(({ nodeIndex, glow, phase }) => {
          glow.position.copy(worldPositions[nodeIndex]);
          glow.material.opacity = 0.17 + (Math.sin(time * 0.72 + phase) + 1) * 0.07;
        });

        anchorIndexes.forEach((nodeIndex, index) => {
          const position = worldPositions[nodeIndex];
          anchorPositions.set([position.x, position.y, position.z], index * 3);
        });

        signalRoutes.forEach(({ source, target, speed, phase }, index) => {
          const progress = (time * speed + phase) % 1;
          const position = worldPositions[source].clone().lerp(worldPositions[target], progress);
          signalPositions.set([position.x, position.y, position.z], index * 3);
        });

        pointsGeometry.attributes.position.needsUpdate = true;
        lineGeometry.attributes.position.needsUpdate = true;
        lineGeometry.attributes.color.needsUpdate = true;
        anchorGeometry.attributes.position.needsUpdate = true;
        signalGeometry.attributes.position.needsUpdate = true;
        midground.update(time);
        background.update(time);
      };

      const render = (now: number) => {
        if (!isVisible || document.hidden) {
          animationFrame = 0;
          return;
        }

        const time = now / 1000;
        pointerCurrent.lerp(pointerTarget, 0.018);
        foregroundLayer.rotation.set(pointerCurrent.y, pointerCurrent.x, 0);
        midground.layer.rotation.set(-pointerCurrent.y * 0.35, pointerCurrent.x * 0.45, 0);
        updateGeometry(time);
        renderer.render(scene, camera);
        animationFrame = window.requestAnimationFrame(render);
      };

      const start = () => {
        if (!animationFrame && isVisible && !document.hidden) {
          animationFrame = window.requestAnimationFrame(render);
        }
      };

      const observer = new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible) start();
      }, { threshold: 0.05 });
      observer.observe(root);

      const handleVisibility = () => start();
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const handleMotionChange = () => {
        if (motionQuery.matches && animationFrame) {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          root.classList.remove('is-enhanced');
        }
      };

      window.addEventListener('resize', updateSize, { passive: true });
      window.addEventListener('pointermove', updatePointer, { passive: true });
      document.addEventListener('visibilitychange', handleVisibility);
      motionQuery.addEventListener('change', handleMotionChange);
      updateSize();
      root.classList.add('is-enhanced');
      start();
    } catch {
      // The CSS field remains visible when WebGL or the module cannot initialize.
      root.classList.remove('is-enhanced');
    }
  };

  document.querySelectorAll<NetworkRoot>('[data-network-background]:not([data-network-mounted])').forEach((root) => {
    void mountNetwork(root);
  });
</script>

<style>
  .network-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .network-background::before,
  .network-background::after {
    content: '';
    position: absolute;
    inset: -18%;
  }

  .network-background::before {
    background:
      radial-gradient(circle at 76% 58%, rgb(0 255 243 / 24%) 0 3px, transparent 4px),
      radial-gradient(circle at 82% 53%, rgb(216 255 0 / 19%) 0 2px, transparent 3px),
      radial-gradient(circle at 86% 68%, rgb(0 255 243 / 16%) 0 2px, transparent 3px),
      radial-gradient(circle at 68% 78%, rgb(216 255 0 / 15%) 0 2px, transparent 3px),
      radial-gradient(circle at 79% 28%, rgb(0 255 243 / 14%) 0 2px, transparent 3px),
      radial-gradient(circle at 85% 22%, rgb(216 255 0 / 12%) 0 1px, transparent 2px);
    opacity: 0.72;
  }

  .network-background::after {
    background:
      linear-gradient(151deg, transparent 50%, rgb(0 255 243 / 12%) 50.1% 50.25%, transparent 50.4%) 61% 69% / 29% 24% no-repeat,
      linear-gradient(29deg, transparent 50%, rgb(216 255 0 / 10%) 50.1% 50.25%, transparent 50.4%) 72% 42% / 27% 28% no-repeat,
      linear-gradient(118deg, transparent 50%, rgb(0 255 243 / 9%) 50.1% 50.25%, transparent 50.4%) 70% 17% / 24% 22% no-repeat;
    opacity: 0.58;
  }

  .network-background__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .network-background.is-enhanced .network-background__canvas {
    opacity: 0.86;
  }

  .network-background.is-enhanced::before,
  .network-background.is-enhanced::after {
    opacity: 0.08;
  }

  @media (max-width: 767px), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .network-background::before,
    .network-background::after {
      opacity: 0.45;
    }
  }
</style>
